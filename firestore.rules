rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidBookmark(data, userId) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.userId == request.auth.uid && data.userId == userId &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
             data.url is string && data.url.size() >= 1 && data.url.size() <= 2048 &&
             data.folder is string && data.folder.size() >= 1 && data.folder.size() <= 100 &&
             data.faviconUrl is string && data.faviconUrl.size() <= 2048 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidShortcut(data, userId) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.userId == request.auth.uid && data.userId == userId &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
             data.url is string && data.url.size() >= 1 && data.url.size() <= 2048 &&
             data.logoUrl is string && data.logoUrl.size() <= 2048 &&
             data.isPinned is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId}/bookmarks/{bookmarkId} {
      allow get: if isSignedIn() &&
                    isValidId(userId) &&
                    isValidId(bookmarkId) &&
                    request.auth.uid == userId &&
                    existing().userId == request.auth.uid;

      allow list: if isSignedIn() &&
                     request.auth.uid == userId &&
                     existing().userId == request.auth.uid;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidId(bookmarkId) &&
                       request.auth.uid == userId &&
                       incoming().keys().hasAll(['userId', 'title', 'url', 'folder', 'faviconUrl', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'title', 'url', 'folder', 'faviconUrl', 'createdAt', 'updatedAt']) &&
                       isValidBookmark(incoming(), userId);

      allow update: if isSignedIn() &&
                       isValidBookmark(incoming(), userId) &&
                       isValidId(userId) &&
                       isValidId(bookmarkId) &&
                       request.auth.uid == userId &&
                       existing().userId == request.auth.uid &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['title', 'url', 'folder', 'faviconUrl', 'updatedAt']);

      allow delete: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidId(bookmarkId) &&
                       request.auth.uid == userId &&
                       existing().userId == request.auth.uid;
    }

    match /users/{userId}/shortcuts/{shortcutId} {
      allow get: if isSignedIn() &&
                    isValidId(userId) &&
                    isValidId(shortcutId) &&
                    request.auth.uid == userId &&
                    existing().userId == request.auth.uid;

      allow list: if isSignedIn() &&
                     request.auth.uid == userId &&
                     existing().userId == request.auth.uid;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidId(shortcutId) &&
                       request.auth.uid == userId &&
                       incoming().keys().hasAll(['userId', 'name', 'url', 'logoUrl', 'isPinned', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'name', 'url', 'logoUrl', 'isPinned', 'createdAt', 'updatedAt']) &&
                       isValidShortcut(incoming(), userId);

      allow update: if isSignedIn() &&
                       isValidShortcut(incoming(), userId) &&
                       isValidId(userId) &&
                       isValidId(shortcutId) &&
                       request.auth.uid == userId &&
                       existing().userId == request.auth.uid &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['name', 'url', 'logoUrl', 'isPinned', 'updatedAt']);

      allow delete: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidId(shortcutId) &&
                       request.auth.uid == userId &&
                       existing().userId == request.auth.uid;
    }
  }
}
